# ==============================================================================
# SankeetShayak Environment Configuration
# ==============================================================================

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# --- CORS & Client Security ---
# Comma-separated allowed frontend origins (e.g. Vite dev: 5173, React dev: 3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Model & Vision Asset Paths ---
MODEL_PATH=models/handshayak_model.joblib
MEDIAPIPE_TASK_PATH=models/hand_landmarker.task

# --- Camera & Vision Settings ---
DEFAULT_CAMERA_INDEX=0
DEFAULT_FPS=30.0

# --- Biomechanical Physics Engine Defaults ---
HAND_MASS_KG=0.40
SAVGOL_WINDOW=7
SAVGOL_POLYORDER=2

# --- Streaming Buffer Settings ---
STREAM_BUFFER_SIZE=30
MIN_FRAMES_INFERENCE=15

# --- Optional Cloud & Firebase Integration (Phase 5) ---
# FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json
# FIREBASE_PROJECT_ID=sankeet-shayak
